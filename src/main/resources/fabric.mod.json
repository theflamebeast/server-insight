{
  "schemaVersion": 1,
  "id": "serverinsight",
  "version": "${version}",
  "name": "Server Insight",
  "description": "Client-side /serverinsight command: server software, plugins and mods, location, TPS estimate, and player/world details. Adds country flags to the multiplayer server list.",
  "authors": [
    "FlameBeast"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/server-insight",
    "sources": "https://github.com/theflamebeast/server-insight",
    "issues": "https://github.com/theflamebeast/server-insight/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.flamebeast.serverinsight.ServerInsightClient"
    ]
  },
  "mixins": [
    "serverinsight.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "fabric-api": "*",
    "minecraft": ">=26.3",
    "java": ">=25"
  }
}
